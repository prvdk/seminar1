            "body": {
              "mode": "raw",
              "raw": "{\n  \"constellationName\": \"{{constellationName}}\",\n  \"satelliteParams\": [\n    {\n      \"type\": \"COMMUNICATION\",\n      \"name\": \"Comm-1\",\n      \"batteryLevel\": 0.9,\n      \"bandwidth\": 600.0\n    },\n    {\n      \"type\": \"IMAGE\",\n      \"name\": \"Img-1\",\n      \"batteryLevel\": 0.95,\n      \"resolution\": 1.4\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/add-satellites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "add-satellites"
              ]
            },
            "description": "Создает или находит группировку и добавляет в нее спутники связи и съемки."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус ответа 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Ответ содержит имя группировки\", function () { const json = pm.response.json(); pm.expect(json.constellationName).to.eql(pm.collectionVariables.get(\"constellationName\")); });",
